# ============================================================
# OREACLEBOT v2.0 - Article-Driven Trading Configuration
# ============================================================

# Snowflake Connection (for enriched article source)
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MIKHAIL
SNOWFLAKE_SCHEMA=PUBLIC

# Manifold Markets (for trading)
MANIFOLD_API_KEY=your_manifold_api_key_here

# OpenAI (for market analysis)
OPENAI_API_KEY=your_openai_api_key_here
OREACLE_MODEL=gpt-4o-mini

# Trading Parameters
OREACLE_MIN_EDGE=0.05          # Minimum edge to trade (5%)
OREACLE_MIN_CONFIDENCE=0.6     # Minimum confidence (60%)
OREACLE_MAX_BET=25             # Maximum bet size in M$

# Debug mode (uncomment to enable)
# DEBUG=1

# ============================================================
# LEGACY CONFIGURATION (for oreaclebot-legacy command)
# ============================================================
# MARKET_SLUG=your_market_slug_here
# OREACLE_COMMENT_ONLY=1
# OREACLE_INTERVAL=900
# OREACLE_DB=./tmp/oreacle.db
# OREACLE_LOG=INFO
# DEEPL_API_KEY=your_deepl_api_key_here